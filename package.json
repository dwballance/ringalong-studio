{
  "name": "ringalong-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "catalog:candidates": "node scripts/find-hymn-candidates.mjs",
    "catalog:refresh": "node scripts/update-hymns.mjs",
    "catalog:update": "npm run catalog:refresh",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:hymns": "vitest run --config vitest.hymns.config.ts",
    "test:e2e:hymns": "playwright test --config playwright.hymns.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/noto-music": "^5.2.0",
    "abcjs": "^6.7.2",
    "fraction.js": "^5.3.4",
    "hyphen": "1.14.1",
    "lucide": "^0.468.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/hyphen": "^1.14.0",
    "@types/node": "^24.0.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.32",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
